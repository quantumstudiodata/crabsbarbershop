# Cadena de conexión de PostgreSQL (Supabase: Project Settings > Database > Connection string > URI).
# En Vercel usa la del "Transaction pooler" (puerto 6543).
DATABASE_URL=postgres://usuario:contraseña@host:5432/postgres

# Solo para el comando de alta inicial (npm run db:seed).
SEED_DUENA_NOMBRE="Nombre Completo De La Dueña"
SEED_ADMIN_NOMBRE="Tu Nombre Completo"
